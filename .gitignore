# ==============================================================================
# Off-Grid Vault .gitignore
# Only track code, configs, manifests, and documentation in Git.
# Heavy binary downloads (ZIMs, GGUFs, wheels, ISOs) are managed by scripts.
# ==============================================================================

# Big Knowledge Archives
*.zim
*.zim.part
*.epub
*.pdf

# Morale & Media Binaries
*.mp4
*.mp3
*.m4b
04_MORALE/

# AI Models & Containers
*.gguf
*.bin
*.onnx
03_INTELLIGENCE/ollama_home/

# Binary Installers & Apps
*.apk
*.AppImage
*.iso
*.img.xz
*.tar.gz
*.zip
05_NAS_HORDE/

# Hardware & Dev Toolchain Caches
02_ENGINEERING/arduino/data/
02_ENGINEERING/arduino/downloads/
02_ENGINEERING/arduino/arduino-cli
02_ENGINEERING/arduino/arduino-cli.yaml
02_ENGINEERING/arduino/libraries/
02_ENGINEERING/python_wheels/*
!02_ENGINEERING/python_wheels/.gitkeep
02_ENGINEERING/git_repos/*
!02_ENGINEERING/git_repos/.gitkeep

# Python Environments & Bytecode
__pycache__/
*.pyc
*.pyo
*.pyd
.venv/
env/

# OS & Temp Artifacts
.DS_Store
Thumbs.db
*.tmp
*.log
*.swp
*~
